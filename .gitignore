# Generated dataset — reproducible from the seed, so it does not belong in git.
# data/samples/ is committed on purpose so the repo reads without running anything.
data/synthetic/

# Secrets — never commit API keys, tokens or connection strings.
# .env.example is the exception: it lists variable names with no values.
.env
.env.*
!.env.example
*.key
*.pem
secrets.json

# Derived artefacts — regenerable; the measured numbers live in the README
results_*.json
data/extracted/

# The decision log is a record of real decisions about real people. It belongs in an
# access-controlled store with a retention policy, not in a git repository.
data/decisions.jsonl

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
